# Playwright Invisible MCP Environment
STEALTHFOX_MCP_TRANSPORT=http
STEALTHFOX_MCP_HOST=0.0.0.0
STEALTHFOX_MCP_PORT=8000
STEALTHFOX_HEADLESS=1
INVISIBLE_MCP_HOME=/data
STEALTHFOX_PROFILE_DIR=/data/profile
STEALTHFOX_DOWNLOADS_DIR=/data/downloads
# Optional host path prefix returned as `hostPath` by `browser_download_url`
STEALTHFOX_HOST_DOWNLOADS_DIR=/data/downloads

# After navigation, wait up to this many ms for DOM stability so single-page
# apps have rendered before the caller reads it. 0 disables.
STEALTHFOX_SPA_SETTLE_MS=2500
# After a click/press/select that changes the URL, wait up to this many ms for
# the route to render. 0 disables. Only fires when the URL actually changed.
STEALTHFOX_SPA_ACTION_SETTLE_MS=2500

# Default character caps for browser_read_text and browser_read_html (0 = unlimited).
STEALTHFOX_READ_TEXT_MAX_CHARS=8000
STEALTHFOX_READ_HTML_MAX_CHARS=12000

# Optional OpenAI-compatible LLM integration for browser_watch / vision helpers
OPENAI_API_BASE=http://localhost:4000/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENROUTER_API_KEY=sk-your-openrouter-key-here
